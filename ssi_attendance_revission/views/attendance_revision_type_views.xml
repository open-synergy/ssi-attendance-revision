<odoo>
<record id="attendance_revision_type_view_search" model="ir.ui.view">
    <field name="name">attendance_revision_type - search</field>
    <field name="model">attendance_revision_type</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="after">
                <field name="reason_selection_method" />
            </xpath>
            <xpath expr="//group[@name='dom_active']" position="after">
                <separator />
                <filter
                        name="dom_selection_manual"
                        string="Manual"
                        domain="[('reason_selection_method', '=', 'manual')]"
                    />
                <filter
                        name="dom_selection_domain"
                        string="Domain"
                        domain="[('reason_selection_method', '=', 'domain')]"
                    />
                <filter
                        name="dom_selection_code"
                        string="Python Code"
                        domain="[('reason_selection_method', '=', 'code')]"
                    />
                <group expand="0" string="Group By">
                    <filter
                            name="grp_reason_selection_method"
                            string="Reason Selection Method"
                            context="{'group_by': 'reason_selection_method'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="attendance_revision_type_view_tree" model="ir.ui.view">
    <field name="name">attendance_revision_type - tree</field>
    <field name="model">attendance_revision_type</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<record id="attendance_revision_type_view_form" model="ir.ui.view">
    <field name="name">attendance_revision_type - form</field>
    <field name="model">attendance_revision_type</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='active']" position="after">
                <notebook>
                    <page name="reason_config" string="Reason Configuration">
                        <group name="reason_config_1" colspan="4" col="2">
                            <field name="reason_selection_method" />
                            <field
                                    name="reason_ids"
                                    attrs="{'invisible':[('reason_selection_method','!=','manual')]}"
                                />
                            <field
                                    name="reason_domain"
                                    widget="domain"
                                    options="{'model': 'attendance_revision_reason', 'in_dialog': True}"
                                    attrs="{'invisible':[('reason_selection_method','!=','domain')]}"
                                />
                            <field
                                    name="reason_python_code"
                                    widget="ace"
                                    attrs="{'invisible':[('reason_selection_method','!=','code')]}"
                                />
                        </group>
                    </page>
                </notebook>
            </xpath>
        </data>
    </field>
</record>

<record id="attendance_revision_type_action" model="ir.actions.act_window">
    <field name="name">Attendance Revision Type</field>
    <field name="res_model">attendance_revision_type</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="attendance_revision_type_menu"
        parent="menu_attendance_revision_configuration"
        action="attendance_revision_type_action"
        sequence="1"
    />

</odoo>

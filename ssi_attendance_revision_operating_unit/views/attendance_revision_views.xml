<odoo>

<!-- TREE VIEW -->
<record id="attendance_revision_view_tree" model="ir.ui.view">
    <field name="name">attendance_revision tree</field>
    <field name="model">attendance_revision</field>
    <field
            name="inherit_id"
            ref="ssi_attendance_revission.attendance_revision_view_tree"
        />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                        optional="hide"
                    />
            </xpath>
        </data>
    </field>
</record>

<!-- SEARCH VIEW -->
<record id="attendance_revision_view_search" model="ir.ui.view">
    <field name="name">attendance_revision search</field>
    <field name="model">attendance_revision</field>
    <field
            name="inherit_id"
            ref="ssi_attendance_revission.attendance_revision_view_search"
        />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
            <xpath expr="//filter[@name='grp_company']" position="after">
                <filter
                        name="grp_ou"
                        string="Operating Unit"
                        context="{'group_by':'operating_unit_id'}"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
        </data>
    </field>
</record>

<!-- FORM VIEW -->
<record id="attendance_revision_view_form" model="ir.ui.view">
    <field name="name">attendance_revision form</field>
    <field name="model">attendance_revision</field>
    <field
            name="inherit_id"
            ref="ssi_attendance_revission.attendance_revision_view_form"
        />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
        </data>
    </field>
</record>

</odoo>
